{
  "name": "ESG Pipeline - Text Input via Telegram",
  "nodes": [
    {
      "parameters": {
        "authentication": "accessToken",
        "token": "8554352368:AAH3HSlxx9ESvChNb0Rwe_Urcp46vzeq5r0",
        "updates": ["message"]
      },
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "functionCode": "const text = $json.message.text;\nif (!text || !text.trim()) return [];\n\n// هر خط = یک شرکت\nconst companies = text.trim().split('\\n').map(line => line.trim()).filter(Boolean);\n\nreturn companies.map(company => ({\n  json: { company_name: company }\n}));\n"
      },
      "name": "Parse Text to Companies",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "batchSize": 1
      },
      "name": "Loop Over Companies",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "command": "python /files/scripts/lseg_scraper.py \"{{$json.company_name}}\""
      },
      "name": "Run LSEG Scraper",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "functionCode": "try {\n  return [{ json: { ...JSON.parse(items[0].json.stdout), raw: items[0].json } }];\n} catch {\n  return [{ json: { company: $json.company_name, found: false } }];\n}"
      },
      "name": "Parse Scraper Output",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.found }}",
              "operation": "equal",
              "value2": true
            }
          ]
        }
      },
      "name": "Found in LSEG?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "command": "python /files/scripts/download_pdf.py \"{{$json.company}}\" \"{{$json.year}}\""
      },
      "name": "Download ESG PDF",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1560, 220]
    },
    {
      "parameters": {
        "chatId": "={{ $json[\"message\"][\"chat\"][\"id\"] }}",
        "document": "={{ $json.stdout.trim() }}",
        "caption": "ESG Report for *{{$json.company}}* ({{ $json.year }})",
        "parseMode": "Markdown"
      },
      "name": "Send PDF to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1780, 220]
    },
    {
      "parameters": {
        "command": "python /files/scripts/pdf_to_md.py \"{{$json.stdout.trim()}}\""
      },
      "name": "Convert PDF → MD",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2000, 220]
    },
    {
      "parameters": {
